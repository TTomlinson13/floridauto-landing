Options -MultiViews
RewriteEngine On

# ---------------------------------------------------------------------------
# 1. Canonical host — strip www, so each page has exactly one URL.
#
#    HTTPS is deliberately not forced here: TLS terminates at Hostinger's edge
#    CDN, so %{HTTPS} is unreliable at this layer and a naive rule risks a
#    redirect loop. http -> https already works upstream.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 2. index.html is never a URL of its own.
#
#    Prerendering writes dist/blog/index.html, so without these the blog index
#    would be reachable at /blog, /blog/, /blog/index and /blog/index.html —
#    four URLs for one page.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+)/index(\.html)?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---------------------------------------------------------------------------
# 3. Extensionless URLs are canonical.
#
#    Prerendered posts are written as blog/<slug>.html but are linked,
#    sitemapped and canonical-tagged as /blog/<slug>, so the .html form has to
#    redirect rather than answer.
#
#    THE_REQUEST holds the original request line and is not rewritten
#    internally, so this fires only for genuine external requests and never for
#    the internal rewrite in section 5. That is what keeps the two from
#    ping-ponging.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---------------------------------------------------------------------------
# 4. Blog index.
#
#    public/blog/ is a real directory — it holds posts.json and the prerendered
#    post pages — so a generic !-d guard skips it and Apache returns 403 for
#    /blog. That was the bug this file was first opened to fix.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+blog/[\s?] [NC]
RewriteRule ^ /blog [R=301,L]

RewriteRule ^blog/?$ /blog/index.html [L]

# ---------------------------------------------------------------------------
# 5. Serve the prerendered file behind its extensionless URL.
#
#    Guarded on the .html actually existing, so it can never invent a page.
#    /404 is excluded to keep the error document from becoming an indexable 200.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} !^/404
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ---------------------------------------------------------------------------
# 6. No catch-all.
#
#    Every real post is prerendered to its own file, so an unknown /blog/<slug>
#    is genuinely missing and should say so rather than serving an empty shell.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html
